# 이 파일은 예시(.example)다. kubectl apply 대상에서 제외되도록 확장자가 .yaml 로 끝나면 안 된다.
#   (과거 파일명 secret.example.yaml 은 `kubectl apply -f k8s/` 디렉터리 적용 시 실제 시크릿을 REPLACE_ME 로 덮어써 CrashLoopBackOff 를 유발했다.)
# 실제 값은 secret.yaml 로 복사해 채운 뒤 `kubectl apply -f secret.yaml`로 적용하고, secret.yaml은 절대 커밋하지 마라 (.gitignore에 추가됨).
# 값 채우는 법: kubectl create secret generic chapchu-auth-secret -n chapchu \
#   --from-literal=GOOGLE_CLIENT_ID=... \
#   --from-literal=GOOGLE_CLIENT_SECRET=... \
#   --from-literal=DB_URL=jdbc:postgresql://<host>:5432/chapchu \
#   --from-literal=DB_USERNAME=... \
#   --from-literal=DB_PASSWORD=... \
#   --from-literal=AUTH_RSA_PRIVATE_KEY=... \
#   --from-literal=AUTH_RSA_PUBLIC_KEY=...
apiVersion: v1
kind: Secret
metadata:
  name: chapchu-auth-secret
  namespace: chapchu
type: Opaque
stringData:
  GOOGLE_CLIENT_ID: "REPLACE_ME"
  GOOGLE_CLIENT_SECRET: "REPLACE_ME"
  # chapchu-api와 동일한 Postgres를 가리켜야 한다 (users 테이블 공유).
  DB_URL: "jdbc:postgresql://REPLACE_ME:5432/chapchu"
  DB_USERNAME: "REPLACE_ME"
  DB_PASSWORD: "REPLACE_ME"
  # 비워두면 매 재시작마다 새 키가 생성되어 기존 발급 토큰이 전부 무효화된다. 운영에서는 반드시 채워라.
  # 키 생성: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt | base64 -w0
  AUTH_RSA_PRIVATE_KEY: ""
  AUTH_RSA_PUBLIC_KEY: ""
